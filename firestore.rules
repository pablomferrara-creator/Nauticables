rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Temporary MVP rules: any authenticated user can read/write the shared
    // workspace document while we finish the real role model.
    match /workspaces/{docId} {
      allow read, write: if signedIn();
    }
  }
}
